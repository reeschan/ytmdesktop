    protected-api["ProtectedAPIManager\nsrc/main/services/protectedapimanager/"]
    player-state-store["PlayerStateStore\nsrc/main/services/playerstatestore/"]
    state-consumers["再生状態の受け手\nsrc/main/integrations/ ほか"]
    app-screens["アプリ画面\nsrc/renderer/windows/"]
    settings-window["設定画面\nsrc/renderer/windows/settings/"]
    config-store["ConfigStore\nsrc/main/services/configstore/"]
