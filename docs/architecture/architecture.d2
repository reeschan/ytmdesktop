# YouTube Music Desktop App (reeschan fork) のアーキテクチャ図
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py docs/architecture/architecture.d2
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
  saas: {
    style: {
      border-radius: 16
      stroke-dash: 3
    }
  }
}

user: User {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F359-users.svg
}

app: "YTMDesktop (Electron)" {
  class: zone
  icon: https://cdn.simpleicons.org/electron

  window: "Main window" {
    class: zone
    icon: https://icons.terrastruct.com/essentials%2F220-layers.svg
    direction: down

    ytm: "YouTube Music view\nvideo behind the page · Grooving screen" {
      class: svc
      icon: https://cdn.simpleicons.org/youtubemusic
    }
    bg: "Background video view\nvideo file + mask (below YTM)" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F002-video%20player.svg
    }
    recorder: "App view (hidden)\nrecords PC audio / mic for 5 s" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F014-music%20player.svg
    }
  }

  screens: "Title bar · Settings · Miniplayer\nVue 3 + Tailwind (tw:)" {
    class: svc
    icon: https://cdn.simpleicons.org/vuedotjs
  }

  main: "Main process" {
    class: zone
    icon: https://cdn.simpleicons.org/nodedotjs

    config: "ConfigStore\nsettings" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F204-settings.svg
    }
    theme: "ThemeManager\ntheme colors · frosted glass · Jacket" {
      class: svc
      icon: https://cdn.simpleicons.org/tailwindcss
    }
    video: "BackgroundVideoManager\nsource · play / pause / hide" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F002-video%20player.svg
    }
    protocol: "ytmd-app:// protocol\napp screens + video file" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F006-window.svg
    }
    player: "PlayerStateStore\nnow playing" {
      class: svc
      icon: https://cdn.simpleicons.org/youtubemusic
    }
    songrec: "SongRecognition\npause YTM · query · search" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F313-search.svg
    }
    grooving: "Grooving\nLLM picks · continuation · call cap" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F078-magic%20wand.svg
    }
    integrations: "Integrations\nDiscord · Custom CSS · Companion · Last.fm" {
      class: svc
      icon: https://icons.terrastruct.com/essentials%2F143-windows.svg
    }
  }
}

file: "Local video file\nmp4 / webm" {
  class: ext
  icon: https://icons.terrastruct.com/essentials%2F257-file.svg
}

external: External {
  class: saas
  direction: down

  ytmusic: "music.youtube.com" {
    class: ext
    icon: https://cdn.simpleicons.org/youtubemusic
  }
  discord: "Discord\nRich Presence (IPC)" {
    class: ext
    icon: https://cdn.simpleicons.org/discord
  }
  lastfm: "Last.fm" {
    class: ext
    icon: https://cdn.simpleicons.org/lastdotfm
  }
  shazam: "Shazam API\n(RapidAPI)" {
    class: ext
    icon: https://cdn.simpleicons.org/shazam
  }
  ytimg: "YouTube image hosts\nytimg · googleusercontent" {
    class: ext
    icon: https://cdn.simpleicons.org/youtube
  }
  llm: "LLM APIs\nGemini · Claude · OpenAI" {
    class: ext
    icon: https://icons.terrastruct.com/essentials%2F111-idea.svg
  }
}

user -> app.window.ytm: listens
user -> app.screens: settings
app.window.ytm <-> external.ytmusic: page + Innertube (Grooving candidates · related · queue · playlist)
app.screens <-> app.main.config: settings (IPC)
app.main.config -> app.main.theme: theme
app.main.config -> app.main.video: video settings
app.main.theme -> app.window.ytm: theme CSS
app.main.theme -> app.screens: CSS variables
app.main.video <-> app.window.ytm: state + mask / has video
app.main.video -> app.window.bg: video file + mask
app.window.bg -> app.main.protocol: video stream
app.main.protocol -> file: reads
app.window.ytm -> app.main.player: player state
app.main.player -> app.main.integrations
app.main.player -> app.main.theme: playing song's jacket
app.main.theme -> external.ytimg: jacket image (HTTPS)
app.main.integrations -> external.discord: activity from templates
app.main.integrations -> external.lastfm: scrobble {style.stroke-dash: 4}
app.window.ytm <-> app.main.songrec: icon press / search the title
app.main.config -> app.main.songrec: API key (encrypted)
app.main.songrec <-> app.window.recorder: record / PCM
app.main.songrec -> external.shazam: PCM (HTTPS)
app.window.ytm <-> app.main.grooving: signals / pairs · list (IPC)
app.main.config <-> app.main.grooving: API key (encrypted) / usage
app.main.grooving -> external.llm: tracks + answers (HTTPS)
app.main.player -> app.main.grooving: reactions · seed song
app.main.songrec -> app.main.grooving: recognized song (seed) {style.stroke-dash: 4}
