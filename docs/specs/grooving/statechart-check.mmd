stateDiagram-v2
    state "Grooving" as All {
        state "Flow" as Flow {
            Closed: Closed
            NeedKey: Key guidance
            Consent: Asking consent
            Setup: Choosing mood
            Collect: Collecting candidates
            PairWait: Waiting for pair
            PairRetry: Retrying pair
            Choose: Choosing from pair
            ListWait: Making list
            ListRetry: Retrying list
            CollectFailed: Collecting failed
            PairFailed: Pair failed
            ListFailed: List failed
            Done: List ready
            Saving: Saving
            Saved: Saved
            [*] --> Closed
            Closed --> NeedKey: press Grooving without key
            Closed --> Consent: press Grooving without consent
            Closed --> Setup: press Grooving ready
            NeedKey --> Closed: open settings
            NeedKey --> Closed: close
            NeedKey --> Closed: leave
            NeedKey --> Closed: reload
            NeedKey --> Closed: withdraw consent
            NeedKey --> Closed: restart app
            Consent --> Setup: agree
            Consent --> Setup: use without history
            Consent --> Closed: decline
            Consent --> Closed: close
            Consent --> Closed: leave
            Consent --> Closed: reload
            Consent --> Closed: withdraw consent
            Consent --> Closed: restart app
            Setup --> Collect: start [shown]
            %% when Shown
            Collect --> PairWait: candidates ready
            Collect --> CollectFailed: cannot collect
            Collect --> CollectFailed: reload
            PairWait --> Choose: pair arrives
            PairWait --> PairRetry: unusable answer
            PairWait --> PairFailed: LLM unreachable
            PairRetry --> Choose: pair arrives
            PairRetry --> PairFailed: unusable answer
            PairRetry --> PairFailed: LLM unreachable
            Choose --> Choose: pick with prefetch ready [shown]
            %% when Shown
            Choose --> PairWait: pick with prefetch pending [shown]
            %% when Shown
            Choose --> PairWait: neither with pairs left [shown]
            %% when Shown
            Choose --> ListWait: pick last pair [shown]
            %% when Shown
            Choose --> ListWait: neither on last pair [shown]
            %% when Shown
            ListWait --> Done: list arrives
            ListWait --> ListRetry: unusable answer
            ListWait --> ListFailed: LLM unreachable
            ListRetry --> Done: list arrives
            ListRetry --> ListFailed: unusable answer
            ListRetry --> ListFailed: LLM unreachable
            CollectFailed --> Collect: retry [shown]
            %% when Shown
            PairFailed --> PairWait: retry [shown]
            %% when Shown
            ListFailed --> ListWait: retry [shown]
            %% when Shown
            Done --> Saving: save [shown]
            %% when Shown
            Saving --> Saved: saved
            Saving --> Done: cannot save
            Saving --> Done: reload
            Done --> Setup: again [shown]
            %% when Shown
            Saved --> Setup: again [shown]
            %% when Shown
            Setup --> Closed: close [shown]
            %% when Shown
            Setup --> Closed: withdraw consent
            Setup --> Closed: restart app
            Collect --> Closed: close [shown]
            %% when Shown
            Collect --> Closed: withdraw consent
            Collect --> Closed: restart app
            PairWait --> Closed: close [shown]
            %% when Shown
            PairWait --> Closed: withdraw consent
            PairWait --> Closed: restart app
            PairRetry --> Closed: close [shown]
            %% when Shown
            PairRetry --> Closed: withdraw consent
            PairRetry --> Closed: restart app
            Choose --> Closed: close [shown]
            %% when Shown
            Choose --> Closed: withdraw consent
            Choose --> Closed: restart app
            ListWait --> Closed: close [shown]
            %% when Shown
            ListWait --> Closed: withdraw consent
            ListWait --> Closed: restart app
            ListRetry --> Closed: close [shown]
            %% when Shown
            ListRetry --> Closed: withdraw consent
            ListRetry --> Closed: restart app
            CollectFailed --> Closed: close [shown]
            %% when Shown
            CollectFailed --> Closed: withdraw consent
            CollectFailed --> Closed: restart app
            PairFailed --> Closed: close [shown]
            %% when Shown
            PairFailed --> Closed: withdraw consent
            PairFailed --> Closed: restart app
            ListFailed --> Closed: close [shown]
            %% when Shown
            ListFailed --> Closed: withdraw consent
            ListFailed --> Closed: restart app
            Done --> Closed: close [shown]
            %% when Shown
            Done --> Closed: withdraw consent
            Done --> Closed: restart app
            Saving --> Closed: close [shown]
            %% when Shown
            Saving --> Closed: withdraw consent
            Saving --> Closed: restart app
            Saved --> Closed: close [shown]
            %% when Shown
            Saved --> Closed: withdraw consent
            Saved --> Closed: restart app
        }
        --
        state "View" as View {
            Gone: Screen closed
            Shown: Shown
            Hidden: Hidden
            [*] --> Gone
            Gone --> Shown: press Grooving without key
            Gone --> Shown: press Grooving without consent
            Gone --> Shown: press Grooving ready
            Shown --> Gone: open settings [key guidance]
            %% when NeedKey
            Shown --> Gone: decline [asking consent]
            %% when Consent
            Shown --> Gone: close
            Shown --> Gone: withdraw consent
            Shown --> Gone: restart app
            Shown --> Gone: leave [key guidance or asking consent]
            %% when NeedKey, Consent
            Shown --> Hidden: leave [past consent]
            %% when not NeedKey, Consent
            Shown --> Gone: reload [key guidance or asking consent]
            %% when NeedKey, Consent
            Shown --> Hidden: reload [past consent]
            %% when not NeedKey, Consent
            Hidden --> Shown: open again
            Hidden --> Gone: withdraw consent
            Hidden --> Gone: restart app
        }
        --
        state "Preview" as Preview {
            Quiet: No preview
            Playing: Previewing
            [*] --> Quiet
            Quiet --> Playing: start preview [choosing and shown]
            %% when Choose, Shown
            Playing --> Playing: preview the other song
            Playing --> Quiet: 15 seconds pass
            Playing --> Quiet: stop preview
            Playing --> Quiet: pick with prefetch ready
            Playing --> Quiet: pick with prefetch pending
            Playing --> Quiet: neither with pairs left
            Playing --> Quiet: pick last pair
            Playing --> Quiet: neither on last pair
            Playing --> Quiet: leave
            Playing --> Quiet: close
            Playing --> Quiet: reload
            Playing --> Quiet: withdraw consent
            Playing --> Quiet: restart app
        }
        --
        state "Queue" as Queue {
            Orig: Original queue
            ThisList: This run's list
            PrevList: Earlier run's list
            [*] --> Orig
            Orig --> ThisList: list arrives [making list]
            %% when ListWait, ListRetry
            PrevList --> ThisList: list arrives [making list]
            %% when ListWait, ListRetry
            ThisList --> PrevList: press Grooving without key [closed]
            %% when Closed
            ThisList --> PrevList: press Grooving without consent [closed]
            %% when Closed
            ThisList --> PrevList: press Grooving ready [closed]
            %% when Closed
            ThisList --> PrevList: again [list ready or saved]
            %% when Done, Saved
            ThisList --> PrevList: restart app
        }
        --
        state "Notice" as Notice {
            NoNotice: No notice
            Waiting: Notice waiting
            [*] --> NoNotice
            NoNotice --> Waiting: restart app [run in progress]
            %% when Collect, PairWait, PairRetry, Choose, ListWait, ListRetry, CollectFailed, PairFailed, ListFailed, Done, Saving
            Waiting --> NoNotice: dismiss notice [choosing mood and shown]
            %% when Setup, Shown
            Waiting --> NoNotice: start [shown]
            %% when Shown
            Waiting --> NoNotice: close [shown]
            %% when Shown
        }
    }

    %% never PreviewWhileClosed: Closed & Previewing -- 閉じているのに、試聴が続いていない
    %% never PreviewWhileNeedKey: Key guidance & Previewing -- 組を選んでいないのに、試聴が続いていない
